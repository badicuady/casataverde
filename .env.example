# Build-time. Keep draft true until identity, privacy and launch details are approved.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_DRAFT=true
# Optional verified E.164 phone number; no phone action is shown if empty.
PUBLIC_PHONE=
# Runtime. HTTPS endpoint returning {"accepted":true,"id":"nonempty-id"} after durable acceptance.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
# Must match the public origin. Required to enable delivery.
INQUIRY_ALLOWED_ORIGIN=
# Set true only when approved privacy notice and recipient/retention details are published.
INQUIRY_PRIVACY_READY=false
