---
import Layout from '../layouts/Layout.astro';
---

<Layout
  lang="ro"
  title="Pagină negăsită / Page not found"
  description="Înapoi la Casa Ta Verde / Back to Casa Ta Verde"
>
  <section class="page-container section">
    <p class="eyebrow">404</p>
    <h1>Pagina nu a fost găsită.</h1>
    <p lang="en" style="margin:25px 0">
      This page could not be found.
    </p>
    <div class="button-row">
      <a class="button" href="/">
        Acasă →
      </a>
      <a class="text-link" href="/en/" lang="en">
        English home →
      </a>
    </div>
  </section>
</Layout>
